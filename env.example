# Secret used to sign JWTs. Set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Database -----------------------------------------------------------
# PRODUCTION: point at Turso. When TURSO_DATABASE_URL is set it always wins,
# and the local SQLite fallback is never used.
#   turso db show <db> --url        -> TURSO_DATABASE_URL
#   turso db tokens create <db>     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# LOCAL: leave both of the above unset. The app falls back automatically to a
# plain SQLite file at ./data/badminton.db — no setup, no account, no network.
# Same schema and same SQL as Turso, so behaviour is identical.

# PERFORMANCE (Turso only): serve reads from a local synced copy instead of a
# network round trip. Big speed-up for a read-heavy app, but it needs a
# PERSISTENT writable disk (a VM, container volume or Fly volume — NOT Vercel
# or Lambda, where /tmp is wiped between invocations), and a write made by a
# different server instance is only visible locally after the next sync.
# TURSO_EMBEDDED_REPLICA=1
# TURSO_SYNC_INTERVAL=60
# TURSO_REPLICA_FILE=turso-replica.db

# Optional: override where local data is stored (defaults to ./data).
DATA_DIR=/absolute/path/to/data
# Optional: rename the local SQLite file (defaults to badminton.db).
LOCAL_DB_FILE=badminton.db

# Escape hatch: allow the local SQLite file even when NODE_ENV=production.
# Only for a self-hosted box with a real persistent disk — on Vercel/Docker/Fly
# the filesystem is ephemeral and every deploy would silently wipe your data.
# ALLOW_LOCAL_DB=1
